  "semanticTokenColors": {
    "function": "#d0c5a9",
    "method": "#d0c5a9",
    "function.declaration": "#d0c5a9",
    "method.declaration": "#d0c5a9",
    "function.defaultLibrary": "#e0ad82",
    "variable": "#bfc9db",
    "parameter": "#bfc9db",
    "property": "#bfc9db",
    "variable.readonly.defaultLibrary": "#d699b5",
    "enumMember": "#d699b5",
    "type": "#82aaa3",
    "class": "#82aaa3",
    "struct": "#82aaa3",
    "enum": "#82aaa3",
    "interface": "#82aaa3",
    "typeParameter": "#82aaa3",
    "namespace": "#82aaa3",
    "macro": "#e0ad82",
    "keyword": "#e67d74",
    "comment": "#87919d",
    "string": "#d4bc7d",
    "number": "#d699b5"
  },
  "tokenColors": [
    {
      "scope": [
        "source",
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable",
        "support.variable.property",
        "variable.other.property",
        "variable.other.object",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#bfc9db"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#87919d"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#d4bc7d"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#d4bc7d"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d699b5"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other.enum",
        "variable.other.enummember",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d699b5"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier",
        "keyword.other",
        "keyword.function",
        "storage.type.function",
        "storage.type.class",
        "storage.type.struct",
        "storage.type.enum",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#e67d74"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#e0ad82"
      }
    },
    {
      "scope": [
        "meta.brace",
        "punctuation.section",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.array"
      ],
      "settings": {
        "foreground": "#bfc9db"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#bfc9db"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.sizeof",
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#e67d74"
      }
    },
    {
      "scope": [
        "storage.type",
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#82aaa3"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#d0c5a9"
      }
    },
    {
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "meta.method-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#d0c5a9"
      }
    },
    {
      "scope": [
        "support.function",
        "support.function.builtin",
        "entity.other.attribute-name",
        "meta.attribute",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#e0ad82"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "entity.name.function.preprocessor",
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#e67d74"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.directive.include",
        "keyword.other.import",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#e67d74"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#e0ad82"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#e67d74",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#e0ad82"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8cc08a"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff5a52"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#f8ad34"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5a52"
      }
    }
  ]
}
