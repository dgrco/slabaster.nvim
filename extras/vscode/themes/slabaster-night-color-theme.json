  "semanticTokenColors": {
    "function": "#e0def4",
    "method": "#e0def4",
    "function.declaration": "#8ab8e0",
    "method.declaration": "#8ab8e0",
    "function.defaultLibrary": "#7dcfff",
    "variable": "#e0def4",
    "parameter": "#e0def4",
    "property": "#e0def4",
    "variable.readonly.defaultLibrary": "#c9a8e0",
    "enumMember": "#c9a8e0",
    "type": "#e0c08a",
    "class": "#e0c08a",
    "struct": "#e0c08a",
    "enum": "#e0c08a",
    "interface": "#e0c08a",
    "typeParameter": "#e0c08a",
    "namespace": "#e0c08a",
    "macro": "#c9a8e0",
    "keyword": "#ee737e",
    "comment": "#565f89",
    "string": "#93c9a8",
    "number": "#c9a8e0"
  },
  "tokenColors": [
    {
      "scope": ["source", "variable", "variable.other", "variable.parameter", "meta.definition.variable", "support.variable.property", "variable.other.property", "variable.other.object", "entity.name.variable"],
      "settings": { "foreground": "#e0def4" }
    },
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#565f89" }
    },
    {
      "scope": ["string", "punctuation.definition.string", "string.quoted", "string.template", "markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#93c9a8" }
    },
    {
      "scope": ["constant.character.escape", "constant.other.placeholder", "string.regexp"],
      "settings": { "foreground": "#7dcfff" }
    },
    {
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#c9a8e0" }
    },
    {
      "scope": ["constant.language", "constant.other.enum", "variable.other.enummember", "variable.other.constant", "support.constant"],
      "settings": { "foreground": "#c9a8e0" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage.modifier", "keyword.other", "keyword.function", "storage.type.function", "storage.type.class", "storage.type.struct", "storage.type.enum", "keyword.declaration"],
      "settings": { "foreground": "#ee737e" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#6b7394" }
    },
    {
      "scope": ["meta.brace", "punctuation.section", "punctuation.definition.block", "punctuation.definition.parameters", "punctuation.definition.arguments", "punctuation.definition.array"],
      "settings": { "foreground": "#6b7394" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#9a97b8" }
    },
    {
      "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.sizeof", "keyword.operator.cast"],
      "settings": { "foreground": "#ee737e" }
    },
    {
      "scope": ["storage.type", "entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class", "entity.name.type.class"],
      "settings": { "foreground": "#e0c08a" }
    },
    {
      "scope": ["entity.name.function", "meta.definition.function entity.name.function", "meta.definition.method entity.name.function"],
      "settings": { "foreground": "#8ab8e0" }
    },
    {
      "scope": ["meta.function-call entity.name.function", "meta.function-call.generic", "meta.method-call entity.name.function", "variable.function"],
      "settings": { "foreground": "#e0def4" }
    },
    {
      "scope": ["support.function", "support.function.builtin", "entity.other.attribute-name", "meta.attribute", "storage.type.annotation", "punctuation.definition.annotation"],
      "settings": { "foreground": "#7dcfff" }
    },
    {
      "scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive", "entity.name.function.preprocessor", "entity.name.function.macro", "support.function.macro"],
      "settings": { "foreground": "#c9a8e0" }
    },
    {
      "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.control.directive.include", "keyword.other.import", "keyword.other.using"],
      "settings": { "foreground": "#b3d99a" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#7dcfff" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#e0c08a", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#7dcfff" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#93c9a8" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ee737e" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#c9a8e0" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ee737e" }
    }
  ]
}
